{
  "name": "@gsd-build/sdk",
  "version": "0.1.0",
  "description": "GSD SDK — programmatic interface for running GSD plans via the Agent SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
