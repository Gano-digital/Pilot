    "directory": "sdk"
  },
  "homepage": "https://github.com/gsd-build/get-shit-done/tree/main/sdk",
  "bugs": {
    "url": "https://github.com/gsd-build/get-shit-done/issues"
  },
  "author": "TÂCHES",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@hono/node-server": "^1.19.13",
    "hono": "^4.12.25",
    "fast-uri": "^4.0.0",
    "qs": "^6.15.2",
    "ip-address": "^10.2.0"
  },
  "scripts": {
